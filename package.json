{
  "name": "wetransfer-clone",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch server/index.mjs\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "start": "NODE_ENV=production node server/index.mjs",
    "test": "node --test server/*.test.mjs",
    "test:e2e": "node tests/e2e.mjs"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.4.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
